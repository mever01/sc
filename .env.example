# ── Simroute API ──────────────────────────────────────────────────────────
SIMROUTE_BASE_URL=https://simroute.pro/api/stubs/handler_api.php
SIMROUTE_API_KEY=your_key_here
SIMROUTE_COUNTRY_ID=47
SIMROUTE_SERVICE_CODE=lcw
# SIMROUTE_POOL_NAME=
# SIMROUTE_PROVIDER_ID=
SIMROUTE_SMS_WAIT_TIMEOUT=180
SIMROUTE_SMS_POLL_INTERVAL=4

# ── LC Waikiki website ────────────────────────────────────────────────────
LCW_DOMAIN=www.lcwaikiki.iq
LCW_SCHEME=https
LCW_REGISTER_PATH=/en/register

# ── Playwright browser ────────────────────────────────────────────────────
HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT=45000
SLOW_MO=80
MAX_CAPTCHA_RETRIES=5

# ── Ollama local vision model ─────────────────────────────────────────────
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=glm-ocr:latest
